        "NSFaceIDUsageDescription": "SpotFinder uses Face ID to securely authenticate you.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
