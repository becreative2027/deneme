{
  "expo": {
    "name": "SpotFinder",
    "slug": "spotfinder",
    "version": "1.0.0",
    "privacyPolicyUrl": "https://sptfinder.com/privacy",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
